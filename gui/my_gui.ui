  <object class="tk.Toplevel" id="window_manuell" named="True">
    <property name="height">400</property>
    <property name="title" translatable="yes">Manuelle Steuerung</property>
    <property name="width">420</property>
    <child>
      <object class="ttk.Frame" id="frame_manuell" named="True">
        <property name="height">400</property>
        <property name="width">420</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">20</property>
          <property name="pady">20</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="ttk.Label" id="label_manuell_title">
            <property name="text" translatable="yes">Manuelle Steuerung</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">10</property>
              <property name="pady">5 15</property>
              <property name="row">0</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Labelframe" id="frame_jog_manuell">
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">10</property>
              <property name="pady">10</property>
              <property name="row">1</property>
              <property name="sticky">nsew</property>
            </layout>
            <child>
              <object class="ttk.Button" id="button_toggle_jog_manuell">
                <property name="text" translatable="yes">▾ Manuelle Steuerung (Jog)</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="columnspan">7</property>
                  <property name="row">0</property>
                  <property name="sticky">ew</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Frame" id="frame_jog_controls_manuell">
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="columnspan">7</property>
                  <property name="row">1</property>
                  <property name="sticky">nsew</property>
                </layout>
                <child>
                  <object class="ttk.Label" id="label_jog_xy_header_manuell">
                    <property name="text" translatable="yes">Ebene (X / Y)</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="columnspan">3</property>
                      <property name="pady">6 6</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Label" id="label_jog_z_header_manuell">
                    <property name="text" translatable="yes">Höhe (Z)</property>
                    <layout manager="grid">
                      <property name="column">4</property>
                      <property name="pady">6 6</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_xplus_manuell">
                    <property name="text" translatable="yes">▲</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_yminus_manuell">
                    <property name="text" translatable="yes">◀</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Label" id="label_jog_center_manuell">
                    <property name="text" translatable="yes">•</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_yplus_manuell">
                    <property name="text" translatable="yes">▶</property>
                    <layout manager="grid">
                      <property name="column">2</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_xminus_manuell">
                    <property name="text" translatable="yes">▼</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Separator" id="sep_jog_manuell">
                    <property name="orient">vertical</property>
                    <layout manager="grid">
                      <property name="column">3</property>
                      <property name="padx">14</property>
                      <property name="row">1</property>
                      <property name="rowspan">3</property>
                      <property name="sticky">ns</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_zplus_manuell">
                    <property name="text" translatable="yes">▲</property>
                    <layout manager="grid">
                      <property name="column">4</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_zminus_manuell">
                    <property name="text" translatable="yes">▼</property>
                    <layout manager="grid">
                      <property name="column">4</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Separator" id="sep2_jog_manuell">
