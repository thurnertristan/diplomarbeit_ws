<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">meine_gui</setting>
      <setting id="description">gui</setting>
      <setting id="template">application</setting>
      <setting id="main_widget">toplevel1</setting>
      <setting id="module_namespace" />
      <setting id="module_name">name</setting>
      <setting id="main_classname">button</setting>
      <setting id="output_dir" />
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2" />
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
    <resources />
  </project>
  <object class="tk.Toplevel" id="mainwindow" named="True">
    <property name="height">800</property>
    <property name="resizable">both</property>
    <property name="title" translatable="yes">FR20 Robotersteuerung</property>
    <property name="width">1200</property>
    <child>
      <object class="ttk.Frame" id="frame_main" named="True">
        <property name="height">800</property>
        <property name="width">1200</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">15</property>
          <property name="pady">15</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="ttk.Label" id="label_title">
            <property name="text" translatable="yes">FR20 Robotersteuerung</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="columnspan">2</property>
              <property name="padx">20</property>
              <property name="pady">5 15</property>
              <property name="row">0</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label_figur1_caption">
            <property name="text" translatable="yes">Form 1</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">20</property>
              <property name="pady">5</property>
              <property name="row">1</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_figur1">
            <property name="command" type="command" cbtype="simple">on_figur1_pressed</property>
            <property name="image">Form1r.png</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">20</property>
              <property name="pady">20</property>
              <property name="row">2</property>
              <property name="sticky">nsew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label_testen_caption">
            <property name="text" translatable="yes">Testen (Tischpose/Drehpose)</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">20</property>
              <property name="pady">5</property>
              <property name="row">1</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_testen">
            <property name="command" type="command" cbtype="simple">on_testen_pressed</property>
            <property name="image">platzhalter_neu.png</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">20</property>
              <property name="pady">20</property>
              <property name="row">2</property>
              <property name="sticky">nsew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label_tischecken_caption">
            <property name="text" translatable="yes">Tisch-Ecken</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">20</property>
              <property name="pady">5</property>
              <property name="row">3</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label_platzhalter_caption">
            <property name="text" translatable="yes">Rohrdrehung testen (Achsen-Test)</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">20</property>
              <property name="pady">5</property>
              <property name="row">3</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_tischecken">
            <property name="command" type="command" cbtype="simple">on_tischecken_pressed</property>
            <property name="image">platzhalter_neu.png</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">20</property>
              <property name="pady">20</property>
              <property name="row">4</property>
              <property name="sticky">nsew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_platzhalter">
            <property name="command" type="command" cbtype="simple">on_rohrdrehung_pressed</property>
            <property name="image">platzhalter_neu.png</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">20</property>
              <property name="pady">20</property>
              <property name="row">4</property>
              <property name="sticky">nsew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_optionen">
            <property name="command" type="command" cbtype="simple">on_optionen_pressed</property>
            <property name="text" translatable="yes">Optionen</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">20</property>
              <property name="pady">15 5</property>
              <property name="row">5</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_beenden">
            <property name="command" type="command" cbtype="simple">on_beenden_pressed</property>
            <property name="text" translatable="yes">Beenden</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">20</property>
              <property name="pady">15 5</property>
              <property name="row">5</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="tk.Toplevel" id="window_optionen" named="True">
    <property name="height">660</property>
