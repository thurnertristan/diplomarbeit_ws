              <object class="ttk.Button" id="button_toggle_jog_kalibrierung">
                <property name="text" translatable="yes">▾ Manuelle Steuerung (Jog)</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="columnspan">7</property>
                  <property name="row">0</property>
                  <property name="sticky">ew</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Frame" id="frame_jog_controls_kalibrierung">
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="columnspan">7</property>
                  <property name="row">1</property>
                  <property name="sticky">nsew</property>
                </layout>
                <child>
                  <object class="ttk.Label" id="label_jog_xy_header_kalibrierung">
                    <property name="text" translatable="yes">Ebene (X / Y)</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="columnspan">3</property>
                      <property name="pady">6 6</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Label" id="label_jog_z_header_kalibrierung">
                    <property name="text" translatable="yes">Höhe (Z)</property>
                    <layout manager="grid">
                      <property name="column">4</property>
                      <property name="pady">6 6</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_xplus_kalibrierung">
                    <property name="text" translatable="yes">▲</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_yminus_kalibrierung">
                    <property name="text" translatable="yes">◀</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Label" id="label_jog_center_kalibrierung">
                    <property name="text" translatable="yes">•</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_yplus_kalibrierung">
                    <property name="text" translatable="yes">▶</property>
                    <layout manager="grid">
                      <property name="column">2</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_xminus_kalibrierung">
                    <property name="text" translatable="yes">▼</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Separator" id="sep_jog_kalibrierung">
                    <property name="orient">vertical</property>
                    <layout manager="grid">
                      <property name="column">3</property>
                      <property name="padx">14</property>
                      <property name="row">1</property>
                      <property name="rowspan">3</property>
                      <property name="sticky">ns</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_zplus_kalibrierung">
                    <property name="text" translatable="yes">▲</property>
                    <layout manager="grid">
                      <property name="column">4</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_zminus_kalibrierung">
                    <property name="text" translatable="yes">▼</property>
                    <layout manager="grid">
                      <property name="column">4</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Separator" id="sep2_jog_kalibrierung">
                    <property name="orient">vertical</property>
                    <layout manager="grid">
                      <property name="column">5</property>
                      <property name="padx">14</property>
                      <property name="row">1</property>
                      <property name="rowspan">3</property>
                      <property name="sticky">ns</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Label" id="label_jog_rot_header_kalibrierung">
                    <property name="text" translatable="yes">Drehung</property>
                    <layout manager="grid">
                      <property name="column">6</property>
                      <property name="pady">6 6</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_rotplus_kalibrierung">
                    <property name="text" translatable="yes">⟳</property>
                    <layout manager="grid">
                      <property name="column">6</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="button_jog_rotminus_kalibrierung">
                    <property name="text" translatable="yes">⟲</property>
                    <layout manager="grid">
                      <property name="column">6</property>
                      <property name="padx">6</property>
                      <property name="pady">4</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="label_position_readout_kalibrierung">
                <property name="text" translatable="yes">TCP  x=+0.000  y=+0.000  z=+0.000 m   j6=+0.0°</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="columnspan">7</property>
                  <property name="pady">10 0</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_kalibrieren">
            <property name="command" type="command" cbtype="simple">on_kalibrieren_pressed</property>
            <property name="text" translatable="yes">Nullpunkt kalibrieren</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="columnspan">4</property>
              <property name="padx">10</property>
              <property name="pady">15 5</property>
              <property name="row">3</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button_kalibrierung_weiter">
            <property name="command" type="command" cbtype="simple">on_kalibrierung_weiter_pressed</property>
            <property name="text" translatable="yes">Weiter ▸</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="columnspan">4</property>
              <property name="padx">10</property>
              <property name="pady">5</property>
              <property name="row">4</property>
              <property name="sticky">ew</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
